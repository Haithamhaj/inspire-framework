# INSPIRE v2 environment template.
# Copy this file to .env.local for local development and paste real values there.
# Never commit .env.local or any file containing real secrets.

# DATABASE
# Required for the API server, Drizzle, auth, assessments, billing records,
# discount codes, reports, and admin data.
# Use a PostgreSQL connection string from your local Postgres, Neon, Replit DB,
# or another managed Postgres provider.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# SERVER / VITE
# Required by both the API server and Vite configs.
# API server convention: PORT=8080.
# Web/mockup Vite convention: use a separate port such as 5173.
PORT=8080

# Required by Vite configs. Use "/" for local root hosting.
BASE_PATH=/

# Optional. Set to "production" only for deployed production runtime.
NODE_ENV=development

# Optional. Replit-only plugin flag read by Vite configs.
REPL_ID=

# AUTHENTICATION
# Required for API auth. Used to sign and verify JWT access tokens.
# Paste a long random value in .env.local.
JWT_SECRET=

# Optional. JWT access token lifetime. Defaults to 7d in code.
JWT_EXPIRES_IN=7d

# Optional. Password hashing cost. Defaults to 12 in code.
BCRYPT_ROUNDS=12

# ADMIN
# Required to log in to /admin and call /api/admin/* routes.
# Also protects the current POST /api/cron/retry manual trigger.
ADMIN_PASSWORD=

# AI PROVIDERS
# Required for report generation through OpenAI.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.4 in code.
OPENAI_MODEL=gpt-5.4

# Optional fallback provider. Report generation tries Anthropic if OpenAI fails.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-6 in code.
ANTHROPIC_MODEL=claude-sonnet-4-6

# EMAIL (RESEND)
# Optional. If omitted, result/failure emails are skipped by the API.
RESEND_API_KEY=

# Optional. Sender display name. Defaults to "INSPIRE Framework" in code.
FROM_NAME=INSPIRE Framework

# Optional. Sender email address. Must be verified in Resend before real sends.
FROM_EMAIL=noreply@example.com

# Optional. Public app URL used to build links inside emails.
APP_URL=http://localhost:5173

# BILLING (PAYPAL)
# Optional until you need paid assessment checkout.
# Use "paypal" for the legacy PayPal flow or "disabled" for Lemon review/staging
# while checkout is intentionally unavailable.
BILLING_PROVIDER=paypal

# Use "sandbox" for local/testing or "live" for production PayPal.
PAYPAL_ENV=sandbox

# Required only for PayPal checkout/config endpoints.
PAYPAL_CLIENT_ID=

# Required only for PayPal order creation/capture.
PAYPAL_SECRET=

# Optional. Assessment price in USD. Defaults to 10.00 in code.
ASSESSMENT_PRICE=10.00

# CRON / RETRY
# Current runtime protects POST /api/cron/retry with ADMIN_PASSWORD.
# CRON_SECRET appears only in legacy attached documentation and is not read by
# current source code. Keep empty unless a future cron route starts using it.
CRON_SECRET=

# LOGGING
# Optional. Pino log level: trace, debug, info, warn, error. Defaults to info.
LOG_LEVEL=info
