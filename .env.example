# ─── DATABASE ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Replit provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── SERVER ──────────────────────────────────────────────────────────────────
# Port for the API server (Replit assigns this automatically)
PORT=8080

# Node environment — set to "production" when deploying
NODE_ENV=development

# ─── AUTHENTICATION ───────────────────────────────────────────────────────────
# REQUIRED — Used to sign & verify all JWTs. Use a long random string (64+ chars).
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-characters-long

# Optional — JWT access token lifetime (default: 7d)
JWT_EXPIRES_IN=7d

# Optional — bcrypt rounds for password hashing (default: 12)
BCRYPT_ROUNDS=12

# ─── AI PROVIDERS ────────────────────────────────────────────────────────────
# REQUIRED — OpenAI API key (primary AI engine)
OPENAI_API_KEY=sk-...

# Optional — Override the OpenAI model (default: gpt-5.4)
OPENAI_MODEL=gpt-5.4

# RECOMMENDED — Anthropic API key (Claude fallback if OpenAI fails)
ANTHROPIC_API_KEY=sk-ant-...

# Optional — Override the Anthropic model (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── ADMIN PANEL ─────────────────────────────────────────────────────────────
# REQUIRED — Password to access /admin dashboard and all /api/admin/* routes
ADMIN_PASSWORD=change-me-to-a-strong-password

# ─── CRON JOB ────────────────────────────────────────────────────────────────
# REQUIRED — Secret header value for the retry cron endpoint (GET /api/cron/retry)
# The cron caller must send: x-cron-secret: <this value>
CRON_SECRET=change-me-to-a-random-secret

# ─── EMAIL (Resend) ───────────────────────────────────────────────────────────
# Optional — Without this, result emails are silently skipped (no crash)
RESEND_API_KEY=re_...

# Optional — Sender display name (default: "INSPIRE Framework")
FROM_NAME=INSPIRE Framework

# Optional — Sender email address (must be verified in Resend dashboard)
FROM_EMAIL=noreply@yourdomain.com

# Optional — Base URL of your deployed app (used in email links)
# Example: https://inspire-framework.replit.app
APP_URL=https://your-deployment-url.replit.app

# ─── LOGGING ─────────────────────────────────────────────────────────────────
# Optional — Pino log level: trace | debug | info | warn | error (default: info)
LOG_LEVEL=info
